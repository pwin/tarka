# Jena's other property functions (apf:concat, apf:str, apf:assign) and its functions
# (afn:strjoin …). afn:now is checked for its datatype only.
PREFIX apf: <http://jena.apache.org/ARQ/property#>
PREFIX afn: <http://jena.apache.org/ARQ/function#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ex:  <http://example.com/>
CONSTRUCT {
  ex:s ex:concat ?concat ; ex:str ?str ; ex:assign ?assign ; ex:assignBack ?back ;
       ex:strjoin ?join ; ex:strjoinNumbers ?joinNumbers ;
       ex:substr ?sub ; ex:substrToEnd ?subEnd ; ex:substrUnicode ?subUnicode ;
       ex:sha1 ?sha1 ; ex:sha1Iri ?sha1Iri ;
       ex:min ?min ; ex:minInteger ?minInteger ; ex:max ?max ;
       ex:pi ?pi ; ex:e ?e ; ex:sqrt2 ?sqrt2 ; ex:sqrt4 ?sqrt4 ; ex:nowType ?nowType
} WHERE {
  ?concat apf:concat (?word 1 <http://example.com/y> "z"@en "3"^^xsd:int) .
  ?str apf:str <http://example.com/w> .
  ?assign apf:assign 42 .
  "back" apf:assign ?back
  BIND(afn:strjoin("-", "a", "b", "c") AS ?join)
  BIND(afn:strjoin(",", ?word, 1, 2.5) AS ?joinNumbers)
  BIND(afn:substr("abcdef", 1, 3) AS ?sub)
  BIND(afn:substr("abcdef", 2) AS ?subEnd)
  BIND(afn:substr("héllo wörld", 1, 4) AS ?subUnicode)
  BIND(afn:sha1sum("abc") AS ?sha1)
  BIND(afn:sha1sum(<http://example.com/x>) AS ?sha1Iri)
  BIND(afn:min(3, 2.5) AS ?min)
  BIND(afn:min(3, 7) AS ?minInteger)
  BIND(afn:max(3, 2.5) AS ?max)
  BIND(afn:pi() AS ?pi)
  BIND(afn:e() AS ?e)
  BIND(afn:sqrt(2) AS ?sqrt2)
  BIND(afn:sqrt(4) AS ?sqrt4)
  BIND(DATATYPE(afn:now()) AS ?nowType)
}
