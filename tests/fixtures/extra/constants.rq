PREFIX ex: <http://example.com/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT {
  ex:Catalog ex:title "Catalogue"@en , "Katalog"@nb ;
      ex:version 2 ; ex:ratio 0.5 ; ex:big 1.5e3 ; ex:open true ;
      ex:released "2024-01-01"^^xsd:date ;
      ex:entry ?e .
  ?e ex:code ?code .
  [] ex:loggedRow ?ROWNUM .
}
WHERE { BIND(IRI(CONCAT("http://example.com/entry/", ?code)) AS ?e) }
