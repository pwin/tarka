# The same links, written for oxi-gen's --split instead of apf:strSplit:
#   tarka run -q tarql/stocks-split.rq -i data/bookshops.csv --split stocks book ";"
# repeats each row once per title, with the title in a new column, ?book.
PREFIX bt: <https://example.org/bookshop-trail/>
PREFIX bs: <https://example.org/bookshop-trail/schema#>

CONSTRUCT {
  ?shop_iri bs:stocks ?book_iri .
}
WHERE {
  BIND(IRI(CONCAT(STR(bt:), "shop-", ?shop)) AS ?shop_iri)
  BIND(IRI(CONCAT(STR(bt:), "book-", ?book)) AS ?book_iri)
}
